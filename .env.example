# Copy this file to .env and replace the placeholders.
# .env is ignored by Git. This example file is safe to commit.

# Local PostgreSQL started with docker compose.
# Use POSTGRES_USER, POSTGRES_PASSWORD, and POSTGRES_DB from docker-compose.yaml.
# The published port is 127.0.0.1:55433.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:55433/budget_tracker"

# Explicit opt-in for local development without Supabase.
# This has no effect unless NODE_ENV is development and the app is opened on localhost.
LOCAL_AUTH_BYPASS="true"

# Optional identity used only by the local auth bypass.
LOCAL_DEV_USER_ID="local-dev-user"
LOCAL_DEV_USER_EMAIL="local@example.com"

# Supabase Auth. Leave these unset when LOCAL_AUTH_BYPASS=true.
# If both values are set, the app uses Supabase and the local bypass stays off.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
