generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TagCategory {
  INCOME
  SAVINGS
}

enum SavingDestinationType {
  GENERAL
  PROJECT
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  READY
  COMPLETED
}

model Month {
  id                       String   @id @default(cuid())
  userId                   String
  label                    String
  year                     Int
  month                    Int
  remainingBalanceOverride Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  incomes         Income[]
  budgetLineItems BudgetLineItem[]
  savings         Saving[]

  @@index([userId])
  @@unique([userId, year, month])
}

model Tag {
  id          String      @id @default(cuid())
  userId      String
  code        String
  label       String?
  category    TagCategory
  isSystemTag Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  incomes     Income[]
  savings     Saving[]

  @@index([userId, category])
  @@unique([userId, code, category])
}

model Income {
  id      String  @id @default(cuid())
  monthId String
  label   String
  amount  Float
  tagId   String?

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
  tag   Tag?  @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@index([tagId])
}

model BudgetLineItem {
  id       String @id @default(cuid())
  monthId  String
  label    String
  amount   Float
  category String?

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model Saving {
  id              String                @id @default(cuid())
  monthId          String
  label            String
  amount           Float
  destinationType  SavingDestinationType
  tagId            String?
  projectId        String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  month   Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  tag     Tag?     @relation(fields: [tagId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([monthId])
  @@index([tagId])
  @@index([projectId])
  @@index([destinationType])
}

model Project {
  id                String        @id @default(cuid())
  userId            String
  title             String
  targetAmount      Float
  legacySavedAmount Float         @default(0) @map("savedAmount")
  status            ProjectStatus @default(PENDING)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  savings Saving[]

  @@index([userId])
}
