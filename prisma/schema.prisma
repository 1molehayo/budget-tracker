generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SavingCategory {
  AJO
  OTHER
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
}

model Month {
  id                       String   @id @default(cuid())
  userId                   String
  label                    String
  year                     Int
  month                    Int
  remainingBalanceOverride Float?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  incomes         Income[]
  budgetLineItems BudgetLineItem[]
  savings         Saving[]

  @@index([userId])
  @@unique([userId, year, month])
}

model Income {
  id      String @id @default(cuid())
  monthId String
  label   String
  amount  Float

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model BudgetLineItem {
  id       String @id @default(cuid())
  monthId  String
  label    String
  amount   Float
  category String?

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model Saving {
  id       String         @id @default(cuid())
  monthId  String
  label    String
  amount   Float
  category SavingCategory @default(OTHER)

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model Project {
  id           String        @id @default(cuid())
  userId       String
  title        String
  targetAmount Float
  savedAmount  Float         @default(0)
  status       ProjectStatus @default(PLANNED)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}
